{
  "expo": {
    "name": "Agora Fire",
    "slug": "agora-fire",
    "scheme": "agorafire",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/ibex-dark.jpg",
    "backgroundColor": "#121212",
    "android": {
      "package": "com.agorafire.app",
      "adaptiveIcon": { "foregroundImage": "./assets/brand/ibex-dark.jpg", "backgroundColor": "#1A1A1A" },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Agora Fire",
      "shortName": "Agora Fire",
      "themeColor": "#1A1A1A",
      "backgroundColor": "#121212",
      "favicon": "./assets/brand/ibex-dark.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", {
        "image": "./assets/brand/ibex-light.jpg",
        "backgroundColor": "#F1EFEC",
        "dark": { "image": "./assets/brand/ibex-dark.jpg", "backgroundColor": "#121212" },
        "imageWidth": 160
      }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
