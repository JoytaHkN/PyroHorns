{
  "expo": {
    "name": "PyroHorns",
    "slug": "pyrohorns",
    "scheme": "pyrohorns",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/ibex-dark.jpg",
    "backgroundColor": "#121212",
    "android": {
      "package": "io.github.joytahkn.pyrohorns",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/ibex-dark.jpg",
        "backgroundColor": "#1A1A1A"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "allowBackup": true,
      "permissions": ["android.permission.MANAGE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "PyroHorns",
      "shortName": "PyroHorns",
      "themeColor": "#1A1A1A",
      "backgroundColor": "#121212",
      "favicon": "./assets/brand/ibex-dark.jpg"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-legacy-packaging",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/ibex-light.jpg",
          "backgroundColor": "#F1EFEC",
          "dark": {
            "image": "./assets/brand/ibex-dark.jpg",
            "backgroundColor": "#121212"
          },
          "imageWidth": 160
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
